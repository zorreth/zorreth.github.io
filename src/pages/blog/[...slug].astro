---
import { type CollectionEntry, render } from 'astro:content';
import Link from '../../components/icons/Link.astro';
import Tooltip from '../../components/Tooltip.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadTime } from '../../utils/getReadTime';
import { getPosts } from '../../utils/getPosts';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const otherPost = (await getPosts()).filter((p) => p.id !== post.id).at(0);
---

<Layout title={post.data.title} description={post.data.description}>
  <a href="/blog">&larr; ../</a>

  <div class="top">
    <h1 class="title animate-fadein">{post.data.title}</h1>

    <Tooltip text="Copy link">
      <button id="copy-link" class="animate-opacity delay" aria-label="Copy link">
        <Link />
      </button>
    </Tooltip>
  </div>

  <p class="animate-opacity">
    By Kirill Siukhin &bull; {formatDate(post.data.pubDate)} &bull; {getReadTime(post.body)}
  </p>

  <hr class="animate-opacity delay-1" />

  <div class="animate-opacity delay-1">
    <Content />
  </div>

  <hr class="animate-opacity delay-1" />

  {otherPost && (
    <div class="other-post animate-opacity delay-1">
      <span>Other post:</span>
      <a class="other-post-link" href={`/blog/${otherPost.id}`}>
        {otherPost.data.title}
      </a>
    </div>
  )}

  <div id="comments-container"></div>
</Layout>

<script>
  const loadComments = () => {
    const container = document.getElementById('comments-container');
    if (!container) return;

    container.innerHTML = '';

    const script = document.createElement('script');
    script.src = 'https://utteranc.es/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('repo', 'zorreth/zorreth.github.io');
    script.setAttribute('issue-term', 'pathname');

    const isDark = document.documentElement.classList.contains('dark');
    script.setAttribute('theme', isDark ? 'github-dark' : 'github-light');

    container.appendChild(script);
  };

  loadComments();

  window.addEventListener('themechange', (e: Event) => {
    const event = e as CustomEvent<{ isDark: boolean }>;
    const theme = event.detail.isDark ? 'github-dark' : 'github-light';

    const iframe = document.querySelector('.utterances-frame') as HTMLIFrameElement;

    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage({ type: 'set-theme', theme }, 'https://utteranc.es');
    }
  });
</script>

<script>
  const copyButton = document.getElementById('copy-link');

  copyButton?.addEventListener('click', async () => {
    try {
      await window.navigator.clipboard.writeText(window.location.href);
    } catch {
      return;
    }

    const tooltip = copyButton.parentElement?.querySelector('[role="tooltip"]');

    if (tooltip) {
      tooltip.textContent = 'Link copied!';
    }

    setTimeout(() => {
      if (tooltip) {
        tooltip.textContent = 'Copy link';
      }
    }, 2000);
  });
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .title {
    margin: 0;
    font-weight: 600;
  }

  #comments-container {
    margin-top: 2rem;
  }

  .other-post {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: flex-start;
    margin-top: 2rem;
    padding: 1rem;
    background-color: var(--color-bg-muted);
    transition: 0.3s background-color;
  }

  .other-post-link {
    font-size: 1.4em;
    font-weight: 600;
  }
</style>
