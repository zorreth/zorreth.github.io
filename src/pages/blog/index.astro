---
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/formatDate';
import { getReadTime } from '../../utils/getReadTime';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog" description="I'm Kirill, and this is my personal blog.">
  <h1 class="animate-fadein">Blog Posts</h1>

  <ul class="posts animate-opacity">
    {posts.map((post) => (
      <li>
        <h2>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </h2>

        <p>
          By Kirill Siukhin &bull; {formatDate(post.data.pubDate)} &bull; {getReadTime(post.body)}
        </p>

        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  ul {
    padding: 0;
    list-style: none;
  }
</style>
