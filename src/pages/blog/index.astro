---
import { formatDate } from '../../utils/formatDate';
import { getReadTime } from '../../utils/getReadTime';
import { getPosts } from '../../utils/getPosts';
import Layout from '../../layouts/Layout.astro';
import Tooltip from '../../components/Tooltip.astro';
import Rss from '../../components/icons/Rss.astro';

const posts = await getPosts();
---

<Layout title="Blog" description="I'm Kirill, and this is my personal blog.">
  <div class="title">
    <h1 class="animate-fadein">Blog Posts</h1>

    <Tooltip text="RSS feed">
      <a href="/rss.xml" class="animate-opacity delay" aria-label="RSS feed">
        <Rss />
      </a>
    </Tooltip>
  </div>

  <ul class="posts animate-opacity">
    {posts.map((post) => (
      <li>
        <h2>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </h2>

        <p>
          By Kirill Siukhin &bull; {formatDate(post.data.pubDate)} &bull; {getReadTime(post.body)}
        </p>

        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .title a {
    display: flex;
    align-items: center;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  ul {
    padding: 0;
    list-style: none;
  }
</style>
