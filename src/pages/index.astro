---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import photo from '../assets/photo.jpg';

const latestPost = (await getCollection('blog')).at(0);
---

<Layout
  title="Home"
  description="Hi! My name is Kirill, and I am a full-stack developer, focused on building a high quality web applications of any size and purpose. Here you can find my bio, blog and the ways to reach me."
>
  <section class="hero">
    <div class="about">
      <h1 class="animate-fadein">Hi, my name is Kirill.</h1>

      <p class="animate-opacity">
        I am a full-stack developer, focused on building a high quality web applications of any size
        and purpose.
      </p>

      <p class="animate-opacity">In my free time I do photography, make music, and speedcube.</p>

      {latestPost && (
        <div class="latest-post animate-opacity delay-1">
          <span>Latest post:</span>
          <a class="latest-post-link" href={`/blog/${latestPost.id}`}>
            {latestPost.data.title}
          </a>
        </div>
      )}
    </div>

    <Image src={photo} class="photo animate-opacity delay-1" alt="Myself" loading="eager" />
  </section>

  <section>
    <h2 class="animate-fadein">Experiences</h2>

    <p class="animate-opacity delay-1">
      I worked in a team for the college projects and made some solo projects using the modern web
      development technologies like Next.js, Astro, TailwindCSS, shadcn-ui, Bun, Fastify, Hono,
      Drizzle ORM, and many more.
    </p>

    <ul class="animate-opacity delay-1">
      <li>
        <a href="https://zorreth.com">zorreth.com</a> – My personal website and blog.
      </li>
      <li>
        <a href="https://github.com/zorreth/balabol.cc">balabol.cc</a> – A free and open-source
        link-in-bio platform.
      </li>
      <li>
        <a href="https://github.com/SoftTrackApp/web">SoftTrack (frontend)</a> –
        Organization-indepent soft skill tracker.
      </li>
    </ul>
  </section>
</Layout>

<style>
  .about {
    max-width: 48rem;
  }

  .hero {
    display: flex;
    justify-content: center;
    gap: 8rem;
    margin-bottom: 2rem;
  }

  .photo {
    width: 20rem;
    height: 20rem;
    border-radius: 50%;
  }

  .latest-post {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: flex-start;
    margin-top: 2rem;
    padding: 1rem;
    border: 1px solid var(--color-bg-muted);
    transition: 0.3s border;
  }

  .latest-post-link {
    font-size: 1.4em;
    font-weight: 600;
  }

  @media screen and (max-width: 900px) {
    .hero {
      flex-direction: column-reverse;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
